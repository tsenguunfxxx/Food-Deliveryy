# MongoDB Atlas холболт. Санн нэрийг заавал оруулна (/food-app),
# эс бөгөөс `test` санг ашиглана.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food-app?retryWrites=true&w=majority

# JWT гарын үсгийн түлхүүр. Дараах командаар шинээр үүсгэнэ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Нууц үг сэргээх холбоос эндээс эхэлнэ (frontend-ийн хаяг).
APP_URL=http://localhost:3001

# Хоосон бол имэйл илгээхгүй, холбоосыг лог руу хэвлэнэ.
RESEND_API_KEY=
MAIL_FROM=NomNom <onboarding@resend.dev>

# Vercel дээр Blob store-ыг төсөлд холбоход OIDC-ээр автоматаар ажиллана.
# Локал дээр турших бол Blob store-ын read-write token-ыг энд тавина.
# ЗӨВХӨН сервер дээр байна — NEXT_PUBLIC_ угтвартай болговол хөтөч рүү задарна.
BLOB_READ_WRITE_TOKEN=

# CORS зөвшөөрөх домэйнууд, таслалаар тусгаарлана.
# Хоосон бол бүх домэйнд нээлттэй (зөвхөн хөгжүүлэлтэд тохирно).
CORS_ORIGINS=

# Локал серверийн порт (Vercel дээр хэрэглэгдэхгүй).
PORT=3000
